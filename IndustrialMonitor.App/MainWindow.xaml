<Window x:Class="IndustrialMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IndustrialMonitor.App"
        xmlns:vm="clr-namespace:IndustrialMonitor.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="Industrial Monitor" Height="600" Width="1000"
        Background="#F0F0F0">
    <Window.Resources>
        <local:StatusToColorConverter x:Key="StatusToColorConverter" xmlns:local="clr-namespace:IndustrialMonitor.App.Converters"/>
    </Window.Resources>
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Equipment Status Dashboard" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Master List -->
            <DataGrid Grid.Column="0" 
                      ItemsSource="{Binding EquipmentList}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      SelectedItem="{Binding SelectedEquipment}"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="White"
                      BorderBrush="#DDDDDD"
                      RowHeight="40"
                      Margin="0,0,10,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                    <DataGridTextColumn Header="Equipment Name" Binding="{Binding Name}" Width="*"/>
                    
                    <DataGridTemplateColumn Header="Status" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}" 
                                        CornerRadius="10" Padding="10,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Temperature (°C)" Binding="{Binding Temperature}" Width="120"/>
                    <DataGridTextColumn Header="Vibration (mm/s)" Binding="{Binding Vibration}" Width="120"/>
                    <DataGridTextColumn Header="Last Updated" Binding="{Binding LastUpdated, StringFormat='HH:mm:ss'}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Details Panel -->
            <Border Grid.Column="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Padding="20">
                <StackPanel DataContext="{Binding SelectedEquipment}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    
                    <TextBlock Text="Equipment Details" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Name" Foreground="Gray" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding Name}" FontSize="16"/>

                    <TextBlock Text="ID" Foreground="Gray" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding Id}" FontSize="16"/>

                    <TextBlock Text="Status" Foreground="Gray" Margin="0,10,0,0"/>
                    <Border Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}" 
                            CornerRadius="5" Padding="5,2" HorizontalAlignment="Left" Margin="0,2,0,0">
                         <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold"/>
                    </Border>

                    <Separator Margin="0,20"/>
                    
                    <TextBlock Text="Live Telemetry" FontSize="16" FontWeight="SemiBold"/>
                    
                    <TextBlock Text="Temperature" Foreground="Gray" Margin="0,10,0,0"/>
                    <ProgressBar Value="{Binding Temperature}" Maximum="120" Height="20" Margin="0,2"/>
                    <TextBlock Text="{Binding Temperature, StringFormat='{}{0} °C'}"/>

                    <TextBlock Text="Vibration" Foreground="Gray" Margin="0,10,0,0"/>
                    <ProgressBar Value="{Binding Vibration}" Maximum="10" Height="20" Margin="0,2"/>
                    <TextBlock Text="{Binding Vibration, StringFormat='{}{0} mm/s'}"/>

                </StackPanel>
            </Border>
            
            <!-- Empty State -->
            <TextBlock Grid.Column="1" Text="Select an item to view details" 
                       VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray">
                 <!-- Note: Basic visibility logic logic needed or reuse trigger above -->
                 <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                         <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedEquipment}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                 </TextBlock.Style>
            </TextBlock>
             
        </Grid>
    </Grid>
</Window>
